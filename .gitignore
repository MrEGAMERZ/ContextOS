# ==============================================================================
# ContextOS - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Filesystem
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Environment, Credentials & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials.json
aws-credentials.json
service-account*.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python virtualenv lib
lib/
!frontend/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter Notebooks
.ipynb_checkpoints

# ------------------------------------------------------------------------------
# Node, JavaScript & Next.js
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Next.js / Frontend builds
.next/
out/
.turbo/
.turbo/
.vercel
dist/

# ------------------------------------------------------------------------------
# Databases, Local Storage & Caches
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres_data/
pgdata/
local_data/
data/
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Logs & Process Output
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
cloudflared.log
ngrok.log

# ------------------------------------------------------------------------------
# IDEs & Developer Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# AI Agent Workspaces & Local Scratch
# ------------------------------------------------------------------------------
.gemini/
.claude/
.cursor/
.gstack/
scratch/
tmp/
temp/
*.tsbuildinfo
